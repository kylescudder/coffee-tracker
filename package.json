{
  "name": "coffee-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "convex"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:convex": "npm --workspace convex run dev",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck"
  }
}
